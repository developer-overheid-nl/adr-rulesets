{
  "name": "@developer-overheid-nl/adr-rulesets",
  "version": "0.0.1",
  "description": "Spectral rulesets for the NL GOV API Design Rules (ADR)",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/developer-overheid-nl/adr-rulesets"
  },
  "homepage": "https://github.com/developer-overheid-nl/adr-rulesets#readme",
  "bugs": {
    "url": "https://github.com/developer-overheid-nl/adr-rulesets/issues"
  },
  "keywords": [
    "spectral",
    "openapi",
    "api-design-rules",
    "adr",
    "nlgov",
    "linter"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "eslint.config.js"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./rulesets": {
      "types": "./dist/rulesets/index.d.mts",
      "import": "./dist/rulesets/index.mjs"
    },
    "./rulesets/adr-20": {
      "types": "./dist/rulesets/adr-20.d.mts",
      "import": "./dist/rulesets/adr-20.mjs"
    },
    "./rulesets/adr-21": {
      "types": "./dist/rulesets/adr-21.d.mts",
      "import": "./dist/rulesets/adr-21.mjs"
    },
    "./rulesets/adr-22": {
      "types": "./dist/rulesets/adr-22.d.mts",
      "import": "./dist/rulesets/adr-22.mjs"
    },
    "./rulesets/adr-draft": {
      "types": "./dist/rulesets/adr-draft.d.mts",
      "import": "./dist/rulesets/adr-draft.mjs"
    },
    "./formats": {
      "types": "./dist/formats.d.mts",
      "import": "./dist/formats.mjs"
    },
    "./rules": {
      "types": "./dist/rules/index.d.mts",
      "import": "./dist/rules/index.mjs"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-rulesets.mjs",
    "build": "tsc --noEmit && tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-core": "^1.21.0",
    "@stoplight/spectral-formats": "^1.8.2",
    "@stoplight/spectral-functions": "^1.10.1",
    "@stoplight/spectral-rulesets": "^1.22.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "js-yaml": "^4.1.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
